{
  "manifest_version": 3,
  "name": "AI Resume Analyzer - Job Scraper",
  "version": "1.0.0",
  "description": "Scrapes job descriptions and titles to analyze against your resume in one click.",
  "permissions": [
    "activeTab",
    "scripting",
    "contextMenus"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon.png",
      "48": "icon.png",
      "128": "icon.png"
    }
  },
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  }
}
